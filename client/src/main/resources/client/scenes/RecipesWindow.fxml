<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.25" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.RecipesWindowCtrl">
    <items>
        <VBox fx:id="sidebarVBox" maxWidth="300.0" style="-fx-background-color: red;">
            <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="1050.0" VBox.vgrow="ALWAYS">
                <ListView fx:id="sidebarRecipeNamesList" prefWidth="200.0" />
            </ScrollPane>

            <HBox alignment="CENTER" prefHeight="50.0" VBox.vgrow="ALWAYS">
                <Button focusTraversable="false" maxHeight="Infinity" maxWidth="Infinity" onAction="#onAddRecipe" style="-fx-border-radius: 0; -fx-background-radius: 0;" text="+" HBox.hgrow="ALWAYS" />
                <Button focusTraversable="false" maxHeight="Infinity" maxWidth="Infinity" style="-fx-border-radius: 0; -fx-background-radius: 0;" text="-" HBox.hgrow="ALWAYS" />
                <Button maxHeight="Infinity" maxWidth="Infinity" mnemonicParsing="false" prefHeight="Infinity" style="-fx-border-radius: 0; -fx-background-radius: 0;" text="Refresh" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <BorderPane minHeight="200.0">
            <top>
                <HBox prefHeight="30.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label prefHeight="Infinity" text="RECIPE NAME">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="duplicateBtn" mnemonicParsing="false" onAction="#onCloneRecipe" prefHeight="Infinity" style="-fx-background-color: transparent; -fx-padding: 4; -fx-cursor: hand;">
                     <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0">
                           <image>
                              <Image url="@client/images/duplicate-icon-sm.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
                    </children>
                </HBox>
            </top>
            <center>
                <ScrollPane maxWidth="Infinity" BorderPane.alignment="CENTER">
                    <VBox fx:id="recipeView" maxHeight="Infinity" maxWidth="Infinity" />
                </ScrollPane>
            </center>
        </BorderPane>
    </items>
</SplitPane>
