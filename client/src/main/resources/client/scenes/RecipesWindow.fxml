<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        prefWidth="600"
        prefHeight="400"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.scenes.RecipesWindowCtrl">

    <!-- TOP BAR (FoodPal) - ongewijzigd -->
    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="40"
              style="-fx-background-color: #d9534f; -fx-padding: 10;">
            <children>
                <Label text="FoodPal"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </top>

    <center>
        <SplitPane
                dividerPositions="0.25"
                prefWidth="600"
                prefHeight="400"
                style="-fx-background-color: #f5f5f5;"
                stylesheets="@/client/scenes/scrollfix.css">

            <items>

                <!-- SIDEBAR: precies hersteld zoals gevraagd -->
                <VBox fx:id="sidebarVBox"
                      maxWidth="300"
                      style="-fx-background-color: transparent;">

                    <ScrollPane
                            fitToHeight="true"
                            fitToWidth="true"
                            prefHeight="1050.0"
                            VBox.vgrow="ALWAYS">
                        <content>
                            <ListView fx:id="sidebarRecipeNamesList"
                                      prefWidth="200.0"/>
                        </content>
                    </ScrollPane>

                    <HBox alignment="CENTER"
                          prefHeight="50.0"
                          VBox.vgrow="ALWAYS"
                          spacing="5"
                          style="-fx-background-color: transparent;">
                        <padding>
                            <Insets top="8.0" right="0.0" bottom="8.0" left="0.0"/>
                        </padding>

                        <!-- Alle onAction handlers exact zoals in de andere file -->
                        <Button fx:id="add"
                                focusTraversable="false"
                                maxHeight="Infinity"
                                maxWidth="Infinity"
                                onAction="#onAddRecipe"
                                text="+"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16;"
                                HBox.hgrow="ALWAYS" />

                        <Button fx:id="remove"
                                focusTraversable="false"
                                maxHeight="Infinity"
                                maxWidth="Infinity"
                                onAction="#onDeleteRecipe"
                                text="-"
                                style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-size: 16;"
                                HBox.hgrow="ALWAYS" />

                        <Button fx:id="refresh"
                                maxHeight="Infinity"
                                maxWidth="Infinity"
                                mnemonicParsing="false"
                                onAction="#refreshLocalRecipes"
                                prefHeight="Infinity"
                                text="⟳"
                                style="-fx-background-color: #0275d8; -fx-text-fill: white; -fx-font-size: 16;"
                                HBox.hgrow="ALWAYS" />
                    </HBox>

                </VBox>

                <!-- RECIPE VIEW (rechter paneel) - ongewijzigd -->
                <BorderPane style="-fx-background-color: #fafafa;">

                    <top>
                        <HBox prefHeight="30"
                              style="-fx-background-color: transparent;"
                              BorderPane.alignment="CENTER">
                            <children>

                                <Label fx:id="recipeNameLabel"
                                       style="-fx-padding: 4;"
                                       text=""
                                       textFill="#111827">
                                    <font>
                                        <Font name="Papyrus" size="20"/>
                                    </font>
                                </Label>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="duplicateBtn"
                                        mnemonicParsing="false"
                                        onAction="#onCloneRecipe"
                                        style="-fx-cursor: hand; -fx-background-color: transparent;">
                                    <graphic>
                                        <ImageView fitHeight="20"
                                                   fitWidth="20">
                                            <image>
                                                <Image url="@/client/images/duplicate.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>

                            </children>
                        </HBox>
                    </top>

                    <center>
                        <ScrollPane
                                style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-background-insets: 0; -fx-padding: 0;"
                                BorderPane.alignment="CENTER">
                            <content>
                                <VBox fx:id="recipeView"
                                      spacing="6"
                                      maxWidth="Infinity"
                                      maxHeight="Infinity"
                                      style="-fx-background-color: #fafafa;"/>
                            </content>
                            <BorderPane.margin>
                                <Insets left="12"/>
                            </BorderPane.margin>
                        </ScrollPane>
                    </center>

                </BorderPane>

            </items>

        </SplitPane>
    </center>

</BorderPane>
