<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.IngredientsWindowCtrl">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="79.0" prefWidth="600.0" style="-fx-background-color: #0275d8; -fx-padding: 10;">
            <children>
                <Label fx:id="name" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Nutrional Value" />
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="backButton"
                        onAction="#onBackToRecipesClick"
                        text="⬅"
                        prefWidth="45" prefHeight="45"
                        minWidth="45" minHeight="45"
                        style="-fx-background-color: transparent;
               -fx-border-color: tranparent;
               -fx-text-fill: white;
               -fx-font-size: 36;
               -fx-font-weight: 900;
               -fx-padding: 0;
               -fx-cursor: hand;" />

            </children>
        </HBox>
    </top>


    <center>
        <SplitPane dividerPositions="0.25" prefHeight="303.0" prefWidth="600" style="-fx-background-color: #f5f5f5;" stylesheets="@/client/scenes/scrollfix.css">

            <items>
                <VBox fx:id="sidebarVBox" maxWidth="300" style="-fx-background-color: transparent;">

                    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <ListView fx:id="sidebarIngredientNamesList" prefWidth="200" />
                        <padding>
                            <Insets bottom="8.0" left="5.0" right="5.0" top="8.0" />
                        </padding>
                    </ScrollPane>


                    <HBox alignment="CENTER" prefHeight="50" spacing="5" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets bottom="8.0" left="0.0" right="0.0" top="8.0" />
                        </padding>

                        <Button fx:id="add" onAction="#handlePlusButtonPress"
                                prefWidth="36" prefHeight="36" minWidth="36" minHeight="36"
                                style="-fx-background-color: #4CAF50; -fx-padding: 0; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 4;"
                                text="+" />

                        <Button fx:id="remove" onAction="#deleteIngredientButtonHandler"
                                prefWidth="36" prefHeight="36" minWidth="36" minHeight="36"
                                style="-fx-background-color: #d9534f; -fx-padding: 0; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 4;"
                                text="-" />

                        <Button fx:id="refresh" onAction="#refreshLocalIngredients"
                                prefWidth="36" prefHeight="36" minWidth="36" minHeight="36"
                                style="-fx-background-color: #0275d8; -fx-padding: 0; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 4;"
                                text="⟳" />
                    </HBox>

                </VBox>


                <BorderPane style="-fx-background-color: #fafafa;">

                    <center>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;">

                            <VBox fx:id="ingredientDetailsView" spacing="7" style="-fx-background-color: #fafafa;-fx-padding: 0 15 15 15;" visible="false">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="nameLabel" style="-fx-font-size: 28px; -fx-text-fill: #333;-fx-font-family: 'Papyrus';" text="[Select Ingredient]" />
                                    <ImageView fitHeight="20" fitWidth="20" onMouseClicked="#handleEditNameClick" pickOnBounds="true" preserveRatio="true" translateY="3.0">
                                        <image>
                                            <Image url="@/client/images/change_text.png" /> </image>
                                    </ImageView>
                                </HBox>

                                <HBox spacing="60" style="-fx-padding: 0 0 5 0; -fx-border-width: 0 0 1 0; -fx-border-color: #ccc;">
                                    <Label fx:id="nutriInfo" text="Nutritional Information" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #555;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id= "per100" text="per 100g" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #555;" />
                                </HBox>

                                <HBox spacing="10">
                                    <Label fx:id="protein" text="Protein:" style="-fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="proteinLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="0.0 g" />
                                </HBox>

                                <HBox spacing="10">
                                    <Label fx:id="fats" text="Fat:" style="-fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="fatLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="0.0 g" />
                                </HBox>

                                <HBox spacing="10">
                                    <Label fx:id="carbs" text="Carbohydrates:" style="-fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="carbohydratesLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="0.0 g" />
                                </HBox>

                                <Region maxHeight="10" VBox.vgrow="ALWAYS" />

                                <HBox spacing="10" style="-fx-padding: 10 0 0 0; -fx-border-width: 1 0 0 0; -fx-border-color: #ccc;">
                                    <Label fx:id= "kcalInf" text="Inferred Kcal:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="kcalLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #0275d8;" text="0" />
                                </HBox>

                                <HBox spacing="10">
                                    <Label fx:id="usedIn" text="Used in:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="recipesUsedInLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #4CAF50;" text="0 recipes" />
                                </HBox>

                                <HBox fx:id="nutriScoreBox" alignment="CENTER_RIGHT" maxWidth="Infinity" spacing="10" />

                            </VBox>
                        </ScrollPane>
                    </center>

                </BorderPane>

            </items>

        </SplitPane>
    </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="18.0" prefWidth="600.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="ingScaleLabel" text="Scale: " />
            <TextField fx:id="ingScaleTextField" prefHeight="20.0" prefWidth="25.0" promptText="1.0">
               <font>
                  <Font size="9.0" />
               </font>
            </TextField>
         </children>
      </HBox>
   </bottom>

</BorderPane>
