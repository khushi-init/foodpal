<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.IngredientsWindowCtrl">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="79.0" prefWidth="600.0" style="-fx-background-color: #0275d8; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Nutrional Value" />
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="backButton" onAction="#onBackToRecipesClick" style="-fx-background-color: transparent; -fx-padding: 0;"> <graphic>
                    <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@/client/images/back button.png" />
                        </image>
                    </ImageView>
                </graphic>
                </Button>
            </children>
        </HBox>
    </top>


    <center>
        <SplitPane dividerPositions="0.25" prefHeight="303.0" prefWidth="600" style="-fx-background-color: #f5f5f5;" stylesheets="@/client/scenes/scrollfix.css">

            <items>
                <VBox fx:id="sidebarVBox" maxWidth="300" style="-fx-background-color: transparent;">

                    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <ListView fx:id="sidebarIngredientNamesList" prefWidth="200" />
                        <padding>
                            <Insets bottom="8.0" left="5.0" right="5.0" top="8.0" />
                        </padding>
                    </ScrollPane>


                    <HBox alignment="CENTER" prefHeight="50" spacing="5" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets bottom="8.0" left="0.0" right="0.0" top="8.0" />
                        </padding>

                        <Button fx:id="add" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16;" text="+" onAction="#handlePlusButtonPress"/>

                        <Button fx:id="remove" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-size: 16;" text="-" onAction="#deleteIngredientButtonHandler"/>

                        <Button fx:id="refresh" style="-fx-background-color: #0275d8; -fx-text-fill: white; -fx-font-size: 16;" text="⟳" />
                    </HBox>

                </VBox>


                <BorderPane style="-fx-background-color: #fafafa;">

                    <center>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-control-inner-background: transparent;">

                            <VBox fx:id="ingredientDetailsView" spacing="7" style="-fx-background-color: #fafafa;-fx-padding: 0 15 15 15;" visible="false">

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="nameLabel" text="[Select Ingredient]" style="-fx-font-size: 28px; -fx-text-fill: #333;-fx-font-family: 'Papyrus';"/>
                                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true" onMouseClicked="#handleEditNameClick" translateY="3.0">
                                        <image>
                                            <Image url="@/client/images/change_text.png" /> </image>
                                    </ImageView>
                                </HBox>

                                <HBox spacing="60" style="-fx-padding: 0 0 5 0; -fx-border-width: 0 0 1 0; -fx-border-color: #ccc;">
                                    <Label text="Nutritional Information" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #555;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label text="per 100g" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #555;" />
                                </HBox>

                                <HBox spacing="10">
                                    <Label text="Protein:" style="-fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="proteinLabel" text="0.0 g" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Label text="Fat:" style="-fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="fatLabel" text="0.0 g" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Label text="Carbohydrates:" style="-fx-font-size: 14px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="carbohydratesLabel" text="0.0 g" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                </HBox>

                                <Region VBox.vgrow="ALWAYS" maxHeight="10"/>

                                <HBox spacing="10" style="-fx-padding: 10 0 0 0; -fx-border-width: 1 0 0 0; -fx-border-color: #ccc;">
                                    <Label text="Inferred Kcal:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="kcalLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #0275d8;"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Label text="Used in:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="recipesUsedInLabel" text="0 recipes" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #4CAF50;"/>
                                </HBox>

                                <HBox fx:id="nutriScoreBox" alignment="CENTER_RIGHT" maxWidth="Infinity" spacing="10"/>

                            </VBox>
                        </ScrollPane>
                    </center>

                </BorderPane>

            </items>

        </SplitPane>
    </center>

</BorderPane>