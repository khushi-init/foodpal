<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.IngredientsWindowCtrl">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="79.0" prefWidth="600.0" style="-fx-background-color: #d9534f; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Nutrional Value" />
                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="backButton" onAction="#onBackToRecipesClick" style="-fx-background-color: transparent; -fx-padding: 0;"> <graphic>
                    <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@/client/images/back button.png" />
                        </image>
                    </ImageView>
                </graphic>
                </Button>
            </children>
        </HBox>
    </top>


    <center>
        <SplitPane dividerPositions="0.25" prefHeight="303.0" prefWidth="600" style="-fx-background-color: #f5f5f5;" stylesheets="@/client/scenes/scrollfix.css">

            <items>
                <VBox fx:id="sidebarVBox" maxWidth="300" style="-fx-background-color: transparent;">

                    <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                        <ListView fx:id="sidebarIngredientNamesList" prefWidth="200" />
                        <padding>
                            <Insets bottom="8.0" left="5.0" right="5.0" top="8.0" />
                        </padding>
                    </ScrollPane>


                    <HBox alignment="CENTER" prefHeight="50" spacing="5" style="-fx-background-color: transparent;">
                        <padding>
                            <Insets bottom="8.0" left="0.0" right="0.0" top="8.0" />
                        </padding>

                        <Button fx:id="add" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16;" text="+" onAction="#handlePlusButtonPress"/>

                        <Button fx:id="remove" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-size: 16;" text="-" />

                        <Button fx:id="refresh" style="-fx-background-color: #0275d8; -fx-text-fill: white; -fx-font-size: 16;" text="⟳" />
                    </HBox>

                </VBox>


                <BorderPane style="-fx-background-color: #fafafa;">

                    <top>
                        <HBox prefHeight="30" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
                            <children>
                            </children>
                        </HBox>
                    </top>

                    <center>
                        <ScrollPane style="-fx-background-color: transparent; -fx-control-inner-background: transparent;">
                            <VBox fx:id="ingredientDetailsView" maxHeight="Infinity" maxWidth="Infinity" spacing="6" style="-fx-background-color: #fafafa;">

                                <Label style="-fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #333;" VBox.vgrow="ALWAYS">
                           <font>
                              <Font name="Papyrus" size="12.0" />
                           </font></Label>

                            </VBox>

                            <BorderPane.margin>
                                <Insets left="12" />
                            </BorderPane.margin>
                        </ScrollPane>
                    </center>

                </BorderPane>

            </items>

        </SplitPane>
    </center>

</BorderPane>
