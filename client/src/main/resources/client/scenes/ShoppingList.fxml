<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.ShoppingListCtrl">


    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="40" style="-fx-background-color: #d9534f; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="Shopping List" />
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </top>


    <center>
        <SplitPane prefHeight="400" prefWidth="600" style="-fx-background-color: #f5f5f5;" stylesheets="@/client/scenes/scrollfix.css">

            <items>


                <BorderPane style="-fx-background-color: #fafafa;">

                    <top>
                        <HBox prefHeight="30" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">

                            <children>

                                <Region HBox.hgrow="ALWAYS" />

                            </children>
                        </HBox>
                    </top>

                    <center>
                        <ScrollPane style="-fx-background-color: transparent; -fx-control-inner-background: transparent;">
                            <VBox fx:id="shoppingListView" maxHeight="Infinity" maxWidth="Infinity" spacing="6" style="-fx-background-color: #fafafa;" />

                            <BorderPane.margin>
                                <Insets left="12" />
                            </BorderPane.margin>
                        </ScrollPane>
                    </center>

                </BorderPane>

            </items>

        </SplitPane>
    </center>

</BorderPane>
