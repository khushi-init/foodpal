<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.ShoppingListCtrl">


    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="40" style="-fx-background-color: #d9534f; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="Shopping List" />
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </top>


    <center>
        <SplitPane prefHeight="400" prefWidth="600" style="-fx-background-color: #f5f5f5;" stylesheets="@/client/scenes/scrollfix.css">

            <items>


                <BorderPane style="-fx-background-color: #fafafa;">

                    <center>
                        <ScrollPane prefWidth="574.0" style="-fx-background-color: #eeeeee; -fx-control-inner-background: transparent;">
                            <VBox fx:id="shoppingListView" maxHeight="Infinity" maxWidth="Infinity" spacing="6" style="-fx-background-color: #fafafa;" />

                            <BorderPane.margin>
                                <Insets left="12.0" right="12.0" top="12.0" />
                            </BorderPane.margin>
                        </ScrollPane>
                    </center>
               <bottom>
                  <VBox prefHeight="40.0" prefWidth="598.0" BorderPane.alignment="CENTER">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Button mnemonicParsing="false" text="Reset">
                                 <HBox.margin>
                                    <Insets left="20.0" right="5.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" text="Download">
                                 <HBox.margin>
                                    <Insets left="5.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
               </bottom>

                </BorderPane>

            </items>

        </SplitPane>
    </center>

</BorderPane>
