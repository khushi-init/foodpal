<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="instructionBox" maxHeight="30.0" maxWidth="Infinity" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.RecipeInstructionUICtrl">
    <Label fx:id="instructionText" prefHeight="Infinity" style="-fx-padding: 8 0 4 0;" text="Recipe Instruction" textFill="#111827" wrapText="true" >
      <font>
         <Font size="14.0" />
      </font></Label>
    <Button onAction="#handleDeleteButton" prefHeight="Infinity" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
      <graphic>
         <ImageView fitHeight="16" fitWidth="16" >
            <image>
               <Image url="@/client/images/delete.png" />
            </image>
         </ImageView>
      </graphic></Button>
    <Button onAction="#handleEditButton" prefHeight="Infinity" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
      <graphic>
         <ImageView fitHeight="200.0" fitWidth="200.0" style="-fx-fit-width: 15; -fx-fit-height: 15;">
            <image>
               <Image url="@/client/images/change_text.png" />
            </image>
         </ImageView>
      </graphic></Button>
</HBox>
