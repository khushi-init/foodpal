<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.popups.IngredientPopUpCtrl">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>


    <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-text-fill: #333333;" text="Edit Ingredient" />
    <VBox spacing="12.0">
        <VBox spacing="4.0">
            <Label fx:id="ingredient" style="-fx-text-fill: #666666; -fx-font-size: 11px;"/>
            <ComboBox fx:id="ingredientComboBox" prefHeight="32.0" maxWidth="Infinity" promptText="Choose an ingredient..." style="-fx-background-radius: 4; -fx-border-radius: 4;" />
        </VBox>

        <HBox spacing="12.0">
            <VBox spacing="4.0" prefWidth="80.0">
                <Label fx:id="quantityLabel" style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="QUANTITY" />
                <TextField fx:id="quantityField" prefHeight="32.0" promptText="0.0" style="-fx-background-radius: 4; -fx-border-radius: 4;" />
            </VBox>

            <VBox spacing="4.0" prefWidth="110.0">
                <Label fx:id="typeLabel" style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="TYPE" />
                <ComboBox fx:id="unitTypePicker" prefHeight="32.0" maxWidth="Infinity" style="-fx-background-radius: 4; -fx-border-radius: 4;" />
            </VBox>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="unitLabel" style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="UNIT" />
                <StackPane alignment="CENTER_LEFT">
                    <ComboBox fx:id="formalUnitPicker" prefHeight="32.0" maxWidth="Infinity" style="-fx-background-radius: 4; -fx-border-radius: 4;" />
                    <TextField fx:id="informalUnitField" prefHeight="32.0" maxWidth="Infinity" promptText="e.g. pinch" style="-fx-background-radius: 4; -fx-border-radius: 4;" />
                </StackPane>
            </VBox>
        </HBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <padding>
            <Insets top="10.0" />
        </padding>
        <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-text-fill: #757575;" text="Cancel" />
        <Button mnemonicParsing="false" onAction="#handleOk" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #0275d8; -fx-text-fill: white; -fx-background-radius: 4;" text="Save" />
    </HBox>
</VBox>