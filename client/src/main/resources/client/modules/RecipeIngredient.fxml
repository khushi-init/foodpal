<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox maxHeight="30.0" minWidth="200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.utils.RecipeIngredientUICtrl">
    <Label fx:id="ingredientText" prefHeight="Infinity" text="Recipe Ingredient" />
    <Region HBox.hgrow="ALWAYS" />
    <Button prefHeight="Infinity" prefWidth="30.0" text="D" />
    <Button prefHeight="Infinity" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
      <graphic>
         <ImageView fitHeight="200.0" fitWidth="200.0" style="-fx-fit-height: 20; -fx-fit-width: 20;">
            <image>
               <Image url="@../images/change_text.png" />
            </image>
         </ImageView>
      </graphic></Button>
</HBox>
