<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox fx:id="ingredientBox" alignment="CENTER_LEFT" maxHeight="30.0" minWidth="200.0" spacing="6" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.utils.ShoppingListIngredientUICtrl">
    <CheckBox fx:id="checkoffBox" mnemonicParsing="false" onAction="#handleCheckoffBox" />
    <Label fx:id="ingredientText" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 0;" text="aaa" textFill="#111827">
        <font>
            <Font size="14.0" />
        </font></Label>
    <Button onAction="#handleDeleteButton" prefHeight="Infinity" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
      <graphic>
         <ImageView fitHeight="16.0" fitWidth="16.0">
            <image>
               <Image url="@/client/images/delete.png" />
            </image>
         </ImageView>
      </graphic></Button>
    <Button onAction="#handleEditButton" prefHeight="Infinity" prefWidth="30.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
      <graphic>
         <ImageView fitHeight="15.0" fitWidth="15.0">
            <image>
               <Image url="@/client/images/change_text.png" />
            </image>
         </ImageView>
      </graphic></Button>
</HBox>
