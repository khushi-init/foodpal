<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.utils.CreateIngredientCtrl"
      alignment="CENTER"
      spacing="10"
      prefWidth="320"
      prefHeight="180">

    <children>
        <Label text="Edit Ingredient"/>

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="35"/>
                <ColumnConstraints percentWidth="65"/>
            </columnConstraints>

            <children>
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Fat:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="fatField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Grams per 100g"/>

                <Label text="Protein:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="proteinField" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Grams per 100g"/>

                <Label text="Carbohydrates:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="carbField" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Grams per 100g"/>
            </children>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <children>
                <Button text="Cancel" onAction="#handleCancel" cancelButton="true"/>
                <Button text="OK" onAction="#handleOk" defaultButton="true"/>
            </children>
        </HBox>
    </children>

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>
</VBox>
